{
  "name": "@veloxts/testing",
  "version": "0.9.0",
  "private": true,
  "description": "Internal testing utilities for VeloxTS framework packages",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@veloxts/core": "workspace:*",
    "fastify": "5.8.5",
    "fastify-plugin": "5.1.0",
    "testcontainers": "11.14.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1037.0",
    "@types/node": "25.6.0",
    "@types/nodemailer": "8.0.0",
    "@types/pg": "8.20.0",
    "nodemailer": "8.0.6",
    "pg": "8.20.0",
    "redis": "5.12.1",
    "typescript": "5.9.3",
    "vitest": "4.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
